generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String            @id @default(uuid())
  name              String
  email             String            @unique
  password_hash     String
  created_at        DateTime          @default(now())
  updated_at        DateTime          @updatedAt
  budgets           Budget[]
  categories        Category[]
  chat_sessions     ChatSession[]
  financial_profile FinancialProfile?
  receipts          Receipt[]
  savings_goals     SavingsGoal[]
  subscriptions     Subscription[]
  transactions      Transaction[]
  documents         FinancialDocument[]
}

model FinancialProfile {
  id                     String   @id @default(uuid())
  user_id                String   @unique
  monthly_income         Decimal? @db.Decimal(10, 2)
  income_type            String?
  monthly_savings_target Decimal? @db.Decimal(10, 2)
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt
  user                   User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Transaction {
  id               String   @id @default(uuid())
  user_id          String
  amount           Decimal  @db.Decimal(12, 2)
  transaction_type String
  merchant         String?
  category         String?
  description      String?
  date             DateTime
  upi_reference    String?
  status           String?
  source           String   @default("MANUAL")
  document_id      String?
  created_at       DateTime @default(now())
  user             User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  document         FinancialDocument? @relation(fields: [document_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([date])
  @@index([category])
  @@index([transaction_type])
}

model FinancialDocument {
  id                String   @id @default(uuid())
  user_id           String
  file_name         String
  file_type         String
  uploaded_at       DateTime @default(now())
  processing_status String   @default("COMPLETED")
  raw_content       String?  // Store raw text content for Q&A
  user              User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions      Transaction[]
}

model Category {
  id      String  @id @default(uuid())
  user_id String?
  name    String
  type    String
  user    User?   @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, name])
}

model Budget {
  id          String  @id @default(uuid())
  user_id     String
  category    String
  amount      Decimal @db.Decimal(10, 2)
  month       Int
  year        Int
  user        User    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, category, month, year])
}

model SavingsGoal {
  id             String    @id @default(uuid())
  user_id        String
  name           String
  target_amount  Decimal   @db.Decimal(12, 2)
  current_amount Decimal   @default(0) @db.Decimal(12, 2)
  target_date    DateTime?
  created_at     DateTime  @default(now())
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Subscription {
  id                String    @id @default(uuid())
  user_id           String
  service_name      String
  amount            Decimal   @db.Decimal(10, 2)
  billing_cycle     String
  next_payment_date DateTime?
  category          String?
  user              User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model Receipt {
  id             String    @id @default(uuid())
  user_id        String
  image_url      String?
  merchant       String?
  amount         Decimal?  @db.Decimal(12, 2)
  date           DateTime?
  extracted_data Json?
  status         String    @default("PENDING")
  user           User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model ChatSession {
  id         String        @id @default(uuid())
  user_id    String
  title      String?
  created_at DateTime      @default(now())
  messages   ChatMessage[]
  user       User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id         String      @id @default(uuid())
  session_id String
  role       String
  content    String
  created_at DateTime    @default(now())
  session    ChatSession @relation(fields: [session_id], references: [id], onDelete: Cascade)
}

model FinancialKnowledge {
  id      String @id @default(uuid())
  title   String
  content String
}
